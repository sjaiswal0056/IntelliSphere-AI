# ==============================================================================
# IntelliSphere AI — Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="IntelliSphere AI — Unified Predictive Intelligence Platform"
TAGLINE="One Platform. Multiple Intelligence Engines. Smarter Decisions."
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security & Authentication
# CRITICAL: In production (ENVIRONMENT="production"), SECRET_KEY must be overridden
# with a secure 256-bit random string generated via:
#   python -c "import secrets; print(secrets.token_hex(32))"
#   or
#   openssl rand -hex 32
SECRET_KEY="intellisphere-ai-super-secret-production-grade-jwt-key-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin User Credentials
# Seeded into database on first startup if SEED_DEMO_ADMIN is true
ADMIN_EMAIL="demo@intellisphere.ai"
ADMIN_PASSWORD="IntelliSphere2026!"
SEED_DEMO_ADMIN=true

# Database Configuration
# Default for development: SQLite (enables immediate execution without external services)
DATABASE_URL="sqlite:///./data/intellisphere.db"

# Production PostgreSQL Configuration (Docker Compose or External Cloud Postgres)
# DATABASE_URL="postgresql://intellisphere_user:your_secure_db_password@localhost:5432/intellisphere"
POSTGRES_USER="intellisphere_user"
POSTGRES_PASSWORD="intellisphere_dev_password_2026"
POSTGRES_DB="intellisphere"

# MLOps & Tracking
MLFLOW_TRACKING_URI="sqlite:///./data/mlflow.db"
MLFLOW_EXPERIMENT_NAME="IntelliSphere-Unified-Platform"

# GenAI & Autonomous AI Data Scientist (Gemini / Claude / OpenAI abstraction)
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
LLM_MODEL="gemini-2.5-flash"
MAX_LLM_TOKENS=4096
TEMPERATURE=0.2

# Storage & File Upload Limits
MAX_UPLOAD_SIZE_MB=50

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
