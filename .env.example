# ==============================================================================
# IntelliSphere AI — Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="IntelliSphere AI — Unified Predictive Intelligence Platform"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security & Authentication
# Generate in prod using: openssl rand -hex 32
SECRET_KEY="intellisphere-ai-super-secret-production-grade-jwt-key-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default: SQLite for seamless local execution without requiring a local Postgres daemon
DATABASE_URL="sqlite:///./data/intellisphere.db"
# Production / Docker Compose PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/intellisphere"

# MLOps & Tracking
MLFLOW_TRACKING_URI="sqlite:///./data/mlflow.db"
MLFLOW_EXPERIMENT_NAME="IntelliSphere-Unified-Platform"

# GenAI & Autonomous Agents
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
LLM_MODEL="gemini-2.5-flash"
MAX_LLM_TOKENS=4096
TEMPERATURE=0.2

# File Upload Limits
MAX_UPLOAD_SIZE_MB=50

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
